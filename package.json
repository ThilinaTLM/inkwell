{
  "name": "excalidash-cf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "db:init:local": "wrangler d1 execute excalidash --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute excalidash --remote --file=./schema.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "hono": "^4.12.16",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "wrangler": "^4.87.0"
  }
}
