{
  "name": "excalidash-cf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "db:init:local": "wrangler d1 execute excalidash --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute excalidash --remote --file=./schema.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.17.6",
    "hono": "^4.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "wrangler": "^3.78.0"
  }
}
