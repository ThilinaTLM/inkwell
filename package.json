{
  "name": "inkwell",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev:worker": "pnpm db:migrate:local",
    "dev:worker": "wrangler dev --port 8888",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "precommit:check": "pnpm check:ci && pnpm typecheck",
    "deploy": "pnpm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrations:list:local": "wrangler d1 migrations list inkwell --local",
    "db:migrations:list:remote": "wrangler d1 migrations list inkwell --remote",
    "db:migrate:local": "wrangler d1 migrations apply inkwell --local",
    "db:migrate:remote": "wrangler d1 migrations apply inkwell --remote",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types",
    "drawio:assets": "node scripts/fetch-drawio-assets.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@blocknote/core": "^0.51.0",
    "@blocknote/react": "^0.51.0",
    "@blocknote/shadcn": "^0.51.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/lora": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@hugeicons/core-free-icons": "^4.1.4",
    "@hugeicons/react": "^1.1.6",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-query": "^5.100.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.19",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "roughjs": "^4.6.6",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/workers-types": "^4.20260518.1",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "wrangler": "^4.92.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@excalidraw/excalidraw@0.18.1": "patches/@excalidraw__excalidraw@0.18.1.patch"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm precommit:check"
  }
}
