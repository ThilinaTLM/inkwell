{
  "name": "inkwell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev:worker": "pnpm db:migrate:local",
    "dev:worker": "wrangler dev --port 8888",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrations:list:local": "wrangler d1 migrations list inkwell --local",
    "db:migrations:list:remote": "wrangler d1 migrations list inkwell --remote",
    "db:migrate:local": "wrangler d1 migrations apply inkwell --local",
    "db:migrate:remote": "wrangler d1 migrations apply inkwell --remote",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci ."
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "roughjs": "^4.6.6",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/workers-types": "^4.20260501.1",
    "@tanstack/react-query-devtools": "^5.100.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "wrangler": "^4.87.0"
  }
}
